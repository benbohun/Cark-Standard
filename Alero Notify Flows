{
  "Name": "Notify on Alero Remote Access Login",
  "Description": "Sends an email alert when a user successfully logs in via Alero (Remote Access).",
  "Enabled": true,
  "Steps": [
    {
      "Type": "Trigger",
      "Name": "Alero Login Detected",
      "EventType": "AleroLogin",  // Trigger on Alero-login events
      "Options": {
        "InvocationType": "OnEvent"
      }
    },
    {
      "Type": "Condition",
      "Name": "Login Successful Check",
      "Expression": "event.Result == 'Success'",
      "ActionIfTrue": "Proceed",
      "ActionIfFalse": "Stop"
    },
    {
      "Type": "Utility",
      "Name": "Send Email Notification",
      "UtilityType": "Email",
      "Options": {
        "To": "security@nickyandretechnologyservices.com", // Change to your alert list
        "Subject": "🔐 Alero Remote Access Login Alert: {{event.UserPrincipalName}}",
        "Body": "User {{event.UserPrincipalName}} just logged in via Alero.\n\n• Time: {{event.Time}}\n• Source IP: {{event.SourceIP}}\n• Device: {{event.DeviceName}}\n\nIf this was unexpected, please investigate immediately."
      }
    }
  ]
}
