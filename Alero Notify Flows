{
  "name": "Notify on Alero Remote Access Login",
  "description": "Send email alert when a successful Alero login occurs.",
  "enabled": true,
  "trigger": {
    "type": "event",
    "sourceId": "Alero",
    "eventType": "RemoteAccessLogin"
  },
  "steps": [
    {
      "type": "condition",
      "name": "Check Login Success",
      "expression": "event.result == 'Success'",
      "nextStepIfTrue": 2,
      "nextStepIfFalse": null
    },
    {
      "type": "action",
      "name": "Send Email Alert",
      "actionType": "sendEmail",
      "settings": {
        "to": ["security@nickyandretechnologyservices.com"],
        "subject": "🔐 Alero Login Alert – {{event.userEmail}}",
        "body": "User {{event.userEmail}} logged in via Alero at {{event.timestamp}} from IP {{event.ipAddress}}."
      }
    }
  ]
}
