PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Adjust thresholds as needed
* * * * * root HOST=vault-cna-prod.privilegecloud.cyberark.cloud PORT=1858 TIMEOUT=5 ALERT_FAILS=3 ALERT_CONN_MS=300 ALERT_DNS_MS=300 /usr/local/bin/vault_curl_probe.sh

