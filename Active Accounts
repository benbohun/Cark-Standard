# Path to input CSV file
$csvPath = "C:\Path\To\Users.csv"

# Import users from CSV
$users = Import-Csv -Path $csvPath

# Store results
$results = @()

foreach ($user in $users) {
    $username = $user.sAMAccountName

    try {
        # Attempt to get user from AD
        $adUser = Get-ADUser -Identity $username -Properties Enabled

        # Determine status
        $status = if ($adUser.Enabled) { "Active" } else { "Disabled" }
    }
    catch {
        # If not found, mark as Not Found
        $status = "Not Found"
    }

    # Add result to array
    $results += [PSCustomObject]@{
        sAMAccountName = $username
        ADStatus       = $status
    }
}

# Export to CSV
$results | Export-Csv -Path "C:\Path\To\AD_User_Status_Report.csv" -NoTypeInformation

Write-Host "✅ Report generated: AD_User_Status_Report.csv"



