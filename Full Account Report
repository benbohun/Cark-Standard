::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
# Import psPAS Module
Write-Host "==== Importing psPAS Module ====" -ForegroundColor Green
Import-Module psPAS

# Prompt user for CyberArk credentials
Write-Host "==== Prompting for CyberArk Credentials ====" -ForegroundColor Green
$UPCred = Get-Credential

# Get header authentication (PCLOUD Admins Only)
Write-Host "==== Getting Identity Header Authentication ====" -ForegroundColor Green
$header = Get-IdentityHeader -IdentityTenantURL "aat4012.id.cyberark.cloud" -psPASFormat -PCloudSubdomain "cna-prod" -UPCreds $UPCred

# Register to use header credentials for PAS session
Write-Host "==== Registering PAS Session ====" -ForegroundColor Green
Use-PASSession $header

# Fetch all PAS accounts (summary)
Write-Host "==== Fetching All PAS Accounts ====" -ForegroundColor Green
$PASAccounts = Get-PASAccount

if (!$PASAccounts -or $PASAccounts.Count -eq 0) {
    Write-Host "No accounts found! Please check connection or permissions." -ForegroundColor Red
    exit
}

# Build dynamic list of all custom property names found in any account
Write-Host "==== Collecting Custom Property Columns ====" -ForegroundColor Green
$allCustomProps = @()
foreach ($acct in $PASAccounts) {
    if ($acct.platformAccountProperties) {
        $allCustomProps += $acct.platformAccountProperties.PSObject.Properties.Name
    }
}
$allCustomProps = $allCustomProps | Select-Object -Unique

# Add standard platform account properties if not present
$forceIncludeProps = @(
    'Logon Account','Reconcile Account','Logon Domain','UserDN','Port','Database','PublicSSHKeyPath','UseSudoOnReconcile',
    'Domain','ApplicationID','ActiveDirectoryID','ReconcileIsWinAccount','Notes','PopulateKey','ImpersonateUser',
    'KeyID','ApplicationObjectID','AWSAccessKeyID','AWSAccountID'
)
$allCustomProps = $allCustomProps + $forceIncludeProps | Select-Object -Unique

# Get unique platforms and safes for lookup
Write-Host "==== Fetching Referenced Platforms and Safes ====" -ForegroundColor Green
$platformIds = $PASAccounts | Select-Object -ExpandProperty platformId -Unique | Where-Object { $_ -and $_.Trim() -ne "" }
$safeNames   = $PASAccounts | Select-Object -ExpandProperty safeName   -Unique | Where-Object { $_ -and $_.Trim() -ne "" }

$platforms = @()
foreach ($platformId in $platformIds) {
    $p = Get-PASPlatform -PlatformID $platformId -ErrorAction SilentlyContinue
    if ($p) { $platforms += $p }
}
$safes = @()
foreach ($safeName in $safeNames) {
    $s = Get-PASSafe -SafeName $safeName -ErrorAction SilentlyContinue
    if ($s) { $safes += $s }
}
$platformsht = @{}
$platforms | ForEach-Object { $platformsht[$_.PlatformID] = $_ }
$safesht = @{}
$safes | ForEach-Object { $safesht[$_.SafeName] = $_ }

# Set export path
$exportPath = "E:\Installation Media\RemovePendingAccount\PASAccounts_Full.csv"

# Prepare detailed report with extended account details
Write-Host "==== Building Extended Account Report (This May Take a Few Minutes) ====" -ForegroundColor Green
$report = @()
$counter = 0
$total = $PASAccounts.Count

foreach ($acct in $PASAccounts) {
    $counter++
    if ($counter % 50 -eq 1) {
        Write-Host "    ...Processed $counter of $total accounts..." -ForegroundColor Green
    }

    # Get extended account info
    $details = Get-PASAccount -id $acct.id

    $platformInfo = $null
    if ($details.platformId -and $platformsht.ContainsKey($details.platformId)) {
        $platformInfo = $platformsht[$details.platformId]
    }
    $safeInfo = $null
    if ($details.safeName -and $safesht.ContainsKey($details.safeName)) {
        $safeInfo = $safesht[$details.safeName]
    }

    # Flatten secretManagement
    $secretStatus = $details.secretManagement.Status
    $accountManaged = $details.secretManagement.automaticManagementEnabled
    $manualManagementReason = $details.secretManagement.manualManagementReason

    # Policy, Change, Verify, Reconcile fields (if platformInfo present)
    $dualControl = $exclusiveUse = $oneTime = $requireReason = $null
    $changeManual = $changeOnAdd = $changeAuto = $changeDays = $changeLast = $changeNext = $changeInReset = $null
    $verifyManual = $verifyOnAdd = $verifyAuto = $verifyDays = $verifyLast = $verifyNext = $null
    $reconcileManual = $reconcileUnSync = $null

    if ($platformInfo) {
        $dualControl   = $platformInfo.Details.PrivilegedAccessWorkflows.RequireDualControlPasswordAccessApproval.IsActive
        $exclusiveUse  = $platformInfo.Details.PrivilegedAccessWorkflows.EnforceCheckinCheckoutExclusiveAccess.IsActive
        $oneTime       = $platformInfo.Details.PrivilegedAccessWorkflows.EnforceOnetimePasswordAccess.IsActive
        $requireReason = $platformInfo.Details.PrivilegedAccessWorkflows.RequireUsersToSpecifyReasonForAccess.IsActive

        $changeManual     = $platformInfo.Details.CredentialsManagementPolicy.Change.AllowManual
        $changeOnAdd      = $platformInfo.Details.CredentialsManagementPolicy.Change.AutoOnAdd
        $changeAuto       = $platformInfo.Details.CredentialsManagementPolicy.Change.PerformAutomatic
        $changeDays       = $platformInfo.Details.CredentialsManagementPolicy.Change.RequirePasswordEveryXDays
        $changeLast       = if ($details.secretManagement.lastModifiedTime) { (Get-Date -Date "01-01-1970").AddSeconds([double]$details.secretManagement.lastModifiedTime) } else { $null }
        $changeNext       = if ($details.secretManagement.lastModifiedTime -and $changeDays) { (Get-Date -Date "01-01-1970").AddSeconds([double]$details.secretManagement.lastModifiedTime).AddDays($changeDays) } else { $null }
        $changeInReset    = $platformInfo.Details.CredentialsManagementPolicy.SecretUpdateConfiguration.ChangePasswordInResetMode

        $verifyManual = $platformInfo.Details.CredentialsManagementPolicy.Verification.AllowManual
        $verifyOnAdd  = $platformInfo.Details.CredentialsManagementPolicy.Verification.AutoOnAdd
        $verifyAuto   = $platformInfo.Details.CredentialsManagementPolicy.Verification.PerformAutomatic
        $verifyDays   = $platformInfo.Details.CredentialsManagementPolicy.Verification.RequirePasswordEveryXDays
        $verifyLast   = if ($details.secretManagement.lastVerifiedTime) { (Get-Date -Date "01-01-1970").AddSeconds([double]$details.secretManagement.lastVerifiedTime) } else { $null }
        $verifyNext   = if ($details.secretManagement.lastVerifiedTime -and $verifyDays) { (Get-Date -Date "01-01-1970").AddSeconds([double]$details.secretManagement.lastVerifiedTime).AddDays($verifyDays) } else { $null }

        $reconcileManual = $platformInfo.Details.CredentialsManagementPolicy.Reconcile.AllowManual
        $reconcileUnSync = $platformInfo.Details.CredentialsManagementPolicy.Reconcile.AutomaticReconcileWhenUnsynced
    }

    $customProps = @{}
    foreach ($p in $allCustomProps) {
        $customProps[$p] = $null
        if ($details.platformAccountProperties -and $details.platformAccountProperties.$p) {
            $customProps[$p] = $details.platformAccountProperties.$p
        }
    }

    $reportObj = [PSCustomObject]@{
        id                       = $details.id
        SafeName                 = $details.safeName
        PlatformID               = $details.platformId
        PlatformName             = if ($platformInfo) { $platformInfo.Details.Name } else { $null }
        Name                     = $details.name
        Address                  = $details.address
        UserName                 = $details.userName
        SecretType               = $details.secretType
        SecretStatus             = $secretStatus
        AccountManaged           = $accountManaged
        ManualManagementReason   = $manualManagementReason
        ManagingCPM              = if ($safeInfo) { $safeInfo.ManagingCPM } else { $null }
        CreatedTime              = $details.createdTime
        CategoryModificationTime = $details.categoryModificationTime
        RestrictedToSpecificMachines = $details.remoteMachinesAccess.accessRestrictedToRemoteMachines
        RemoteMachines           = $details.remoteMachinesAccess.remoteMachines
        DualControl              = $dualControl
        ExclusiveUse             = $exclusiveUse
        OneTime                  = $oneTime
        RequireReason            = $requireReason
        ChangeManual             = $changeManual
        ChangeOnAdd              = $changeOnAdd
        ChangeAuto               = $changeAuto
        ChangeDays               = $changeDays
        ChangeLast               = $changeLast
        ChangeNext               = $changeNext
        ChangeInReset            = $changeInReset
        VerifyManual             = $verifyManual
        VerifyOnAdd              = $verifyOnAdd
        VerifyAuto               = $verifyAuto
        VerifyDays               = $verifyDays
        VerifyLast               = $verifyLast
        VerifyNext               = $verifyNext
        ReconcileManual          = $reconcileManual
        ReconcileUnSync          = $reconcileUnSync
        ObjectName               = $details.name
    }

    foreach ($k in $allCustomProps) {
        $reportObj | Add-Member -MemberType NoteProperty -Name $k -Value $customProps[$k] -Force
    }

    $report += $reportObj
}

# Export to CSV
Write-Host "==== Exporting Report to CSV ====" -ForegroundColor Green
$report | Export-Csv -Path $exportPath -NoTypeInformation

Write-Host "==== PAS FULL ACCOUNT REPORT EXPORTED TO: $exportPath ====" -ForegroundColor Green
