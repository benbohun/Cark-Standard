# ===============================
# CyberArk CCP Client Certificate CSR Generator (No Template)
# ===============================

$CN = Read-Host "Enter the Common Name (CN) — typically the target application's FQDN (e.g., app1.target.cna.com)"
$TempFolder = "C:\Temp"
$InfPath = Join-Path $TempFolder "CyberArk_CCP_ClientCert.inf"
$CsrPath = Join-Path $TempFolder "CyberArk_CCP_ClientCert_$($CN -replace '[^\w]', '_').csr"

if (-Not (Test-Path $TempFolder)) {
    New-Item -ItemType Directory -Path $TempFolder | Out-Null
}

$Subject = "CN=$CN, OU=Identity and Access Management, O=CNA FINANCIAL CORPORATION, L=Chicago, S=Illinois, C=US"

$infContent = @"
[Version]
Signature="\$Windows NT\$"

[NewRequest]
Subject = "$Subject"
KeySpec = 1
KeyLength = 2048
Exportable = TRUE
MachineKeySet = TRUE
SMIME = FALSE
PrivateKeyArchive = FALSE
UserProtected = FALSE
UseExistingKeySet = FALSE
ProviderName = "Microsoft RSA SChannel Cryptographic Provider"
ProviderType = 12
RequestType = PKCS10
KeyUsage = 0xa0

[Extensions]
2.5.29.37 = "{text}"
_continue_ = "1.3.6.1.5.5.7.3.2" ; Client Authentication EKU
"@

Set-Content -Path $InfPath -Value $infContent -Encoding ASCII
Write-Host "✅ INF file created at: $InfPath"

certreq -new $InfPath $CsrPath
Write-Host "`n✅ CSR successfully generated at: $CsrPath"
Invoke-Item $TempFolder






